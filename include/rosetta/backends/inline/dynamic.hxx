{{USER_DEFS_BLOCK}}{{USER_LIB_BLOCK}}

# The demo: walks the registry and prints every class, field and method. It
# includes no per-class header and names no bound type — that is the point.
add_executable({{LIB}}_inspect inspect.cpp)
target_link_libraries({{LIB}}_inspect PRIVATE {{LIB}}_dynamic)
