// the whole argument for the dynamic model.

#include <rosetta/dynamic.h>
#include <iostream>
#include "auto_dynamic.h"

using namespace rosetta::dyn;

static void print_params(const MetaParam *ps, std::size_t n) {
    std::cout << "(";
    for (std::size_t i = 0; i < n; ++i) {
        std::cout << (i ? ", " : "") << ps[i].type->spelling << " " << ps[i].name;
        if (ps[i].is_out) {
            std::cout << " [out]";
        }
    }
    std::cout << ")";
}

int main() {
    {{LIB}}::register_all();

    for (const MetaEnum *e : registry().enums()) {
        std::cout << "enum " << e->qualified << " {";
        for (std::size_t i = 0; i < e->n_values; ++i) {
            std::cout << (i ? ", " : " ") << e->values[i].name << " = " << e->values[i].value;
        }
        std::cout << " }\n";
    }

    for (const MetaClass *k : registry().classes()) {
        std::cout << "\nclass " << k->qualified;
        for (std::size_t i = 0; i < k->n_bases; ++i) {
            std::cout << (i ? ", " : " : ") << k->bases[i]->qualified;
        }
        std::cout << (k->is_abstract ? "  [abstract]" : "") << "\n";
        if (*k->doc) {
            std::cout << "    // " << k->doc << "\n";
        }

        for (std::size_t i = 0; i < k->n_ctors; ++i) {
            std::cout << "    ctor ";
            print_params(k->ctors[i].params, k->ctors[i].n_params);
            std::cout << "\n";
        }

        for (std::size_t i = 0; i < k->n_fields; ++i) {
            const MetaField &f = k->fields[i];
            std::cout << "    " << f.type->spelling << " " << f.name;
            if (f.readonly) {
                std::cout << "  [readonly]";
            }
            if (f.range.has) {
                std::cout << "  [" << f.range.lo << ".." << f.range.hi << "]";
            }
            for (std::size_t j = 0; j < f.n_choices; ++j) {
                std::cout << (j ? ", " : "  choices: ") << f.choices[j];
            }
            if (f.type->n_enumerators) {
                for (std::size_t j = 0; j < f.type->n_enumerators; ++j) {
                    std::cout << (j ? ", " : "  values: ") << f.type->enumerators[j].name;
                }
            }
            if (!f.get) {
                std::cout << "  [not readable]";
            }
            std::cout << "\n";
        }

        for (std::size_t i = 0; i < k->n_methods; ++i) {
            const MetaMethod &m = k->methods[i];
            std::cout << "    " << (m.is_static ? "static " : "") << m.ret->spelling << " "
                      << m.name;
            print_params(m.params, m.n_params);
