{{LIB}}::register_all();

const MetaClass *k = registry().find_class("YourClass");
Result made = Object::create(*k, {Any::text("hello"), Any::integer(3)});
Object obj  = Object::adopt(*k, made.value.as_object().ptr, made.value.as_object().owner);

