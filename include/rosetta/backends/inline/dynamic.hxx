// Dynamic object-model backend, emitter. Included by inline/generate.hxx after
// the shared render helpers and backends/python.h (for qualify_std).
//
// Output shape, per target:
//
//   dynamic/auto_dynamic.h    — declares register_all()
//   dynamic/auto_dynamic.cpp  — the TypeDesc / MetaField / MetaMethod / MetaClass
//                               tables and one thunk per member
//   dynamic/inspect.cpp       — a demo that prints the whole registry, i.e. the
//                               "menus without codegen" claim, executable
//   dynamic/CMakeLists.txt    — stock C++20, no reflection
//   dynamic/README.md
//
// One thing worth noticing in the emitted thunks: they call the member BY NAME
// with concrete, exactly-typed argument expressions (value_cast<int>(a[0])), so
// C++'s own overload resolution picks the right one. Every other backend has to
// spell a disambiguating static_cast to a member-function-pointer type
// (GenMethod::is_overloaded exists for that), and the ones that cannot register
// two same-named entries drop the siblings entirely. Here both problems just
// do not arise.

#pragma once

namespace rosetta {
    namespace backend {
        using namespace gen_detail; // shared render / IR helpers

        // -------- templates ------------------------------------------------

        constexpr std::string_view DYNX_CMAKE =
