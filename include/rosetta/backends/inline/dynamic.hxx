# Stock C++20: NO reflection, NO <experimental/meta>. The only rosetta header
# used is <rosetta/dynamic.h>, which is itself ordinary C++.
cmake_minimum_required(VERSION 3.18)
project({{LIB}}_dynamic CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON){{BUILD_CONFIG}}

set(ROSETTA_INCLUDE "{{ROSETTA_INCLUDE}}")

