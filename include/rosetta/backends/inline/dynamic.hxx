                          << "]";
            }
            if (!m.invoke) {
                std::cout << "  [not callable: " << m.skip_reason << "]";
            }
            std::cout << "\n";
        }
    }

    for (const MetaFunction *f : registry().functions()) {
        std::cout << "\n" << f->ret->spelling << " " << f->qualified;
