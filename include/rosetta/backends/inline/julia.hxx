)MD";

        // --- Marshalling gates -------------------------------------------------
        // jlcxx's boundary rules: scalars / bool / std::string / enums map
        // natively; a registered class crosses as a wrapped object; with
        // <jlcxx/stl.hpp> a std::vector<T> registers lazily on first use (any
        // T, including bound classes). What can't cross: std::function (no
        // Julia-closure -> std::function conversion), std::array (not an stl.hpp
        // container), unregistered objects/pointees, and mutable references to
        // NON-class types (the converted argument is a temporary). Copies
        // happen wherever python copies (field accessors, by-value
        // crossings), so the same copyability gates apply.

        inline bool jx_is_bound(const std::string &name, const GenContext &c) {
            for (const auto &k : c.classes) {
                if (k.name == name || qualified_of(k) == name) {
                    return true;
                }
            }
            return false;
        }

        // A C string (or a std::filesystem::path) crosses as a std::string
        // through a wrapping lambda (jx_string_lambda): jlcxx has no caster that
        // would bind either as the type it is.
        inline bool jx_string_shape(const GenType &t) { return t.is_cstring || t.is_path; }

        inline bool jx_touches_string(const GenMethod &m) {
            if (jx_string_shape(m.ret)) {
                return true;
            }
            for (const auto &p : m.params) {
                if (jx_string_shape(p.type)) {
                    return true;
                }
            }
            return false;
        }

        inline bool jx_marshalable(const GenType &t, const GenContext &c) {
            if (t.is_cstring) {
                return true; // adapted — see jx_string_lambda
            }
            // Raw pointer to a bound class: jlcxx passes/returns it as a
            // CxxPtr-style non-owning handle to the registered type.
            if (t.is_pointer) {
                return jx_is_bound(t.object, c);
            }
            if (t.kind == "unknown") {
                return false; // std::function & friends
            }
            if (t.kind == "object") {
                return jx_is_bound(t.object, c);
            }
            if (t.kind == "vector") {
                if (t.element.empty()) {
                    return true;
                }
                if (t.element.front().is_pointer) {
                    return false; // container of raw pointers stays out
                }
                return jx_marshalable(t.element.front(), c);
            }
            if (t.kind == "enum") {
                // jlcxx resolves every argument type when the method is
                // REGISTERED, so a signature naming an enum the module never
                // add_bits'd fails the whole module load ("No appropriate
                // factory for type vtkDataArray::MemorySpace") — not just the
                // one call, as in pybind or embind.
                for (const auto &e : c.enums) {
                    if (t.object_qualified.empty() ? e.name == t.object
                                                   : qualified_of(e) == t.object_qualified) {
                        return true;
                    }
                }
                return false;
            }
            return true; // number / boolean / string / void
        }

        // Copies at the boundary need copyable payloads (same rule as
        // px_copyable — field accessors and by-value crossings copy).
        inline bool jx_copyable(const GenType &t) {
            if (t.kind == "object") {
                return t.copy_constructible && t.copy_assignable;
            }
            if (t.kind == "vector") {
                return t.element.empty() || jx_copyable(t.element.front());
            }
            return true;
        }

        inline bool jx_method_ok(const GenMethod &m, const GenContext &c) {
            if (m.ret.kind != "void" && !jx_marshalable(m.ret, c)) {
                return false;
            }
            // A class / vector return crosses by value (an lvalue-ref return is
            // copied through a wrapping lambda, matching pybind's `automatic`
            // policy), so it must be copy-constructible.
            if (m.ret.kind == "object" && !m.ret.copy_constructible) {
                return false;
            }
            if (m.ret.kind == "vector" && !jx_copyable(m.ret)) {
                return false;
            }
            for (const auto &p : m.params) {
                if (!jx_marshalable(p.type, c)) {
                    return false;
                }
                if (p.type.kind == "object" && !p.is_ref && !p.type.copy_constructible) {
                    return false; // by-value class parameter copy-constructs
                }
                if (p.type.kind == "vector" && !jx_copyable(p.type)) {
                    return false;
                }
                // Mutable ref to a NON-class type (std::string&, index_t&): an
                // out-parameter — the converted argument is a temporary.
                if (p.type.kind != "object" && p.is_mutable_ref) {
                    return false;
                }
            }
            return true;
        }

        // Both field accessors copy (getter by value, setter by copy
        // assignment) — the python rule.
        inline bool jx_field_ok(const GenField &f, const GenContext &c) {
            if (!jx_marshalable(f.type, c)) {
                return false;
            }
            if (f.type.kind == "object" && !f.type.copy_constructible) {
                return false; // even the getter would copy
            }
            return jx_copyable(f.type) || f.is_readonly;
        }

        // Is the setter emittable, or must the field stay getter-only?
        inline bool jx_field_readonly(const GenField &f) {
            if (f.is_readonly) {
                return true;
            }
            return !jx_copyable(f.type);
        }

        // A compilable C++ spelling for an IR type (value form). Exact
        // spellings via param_cpp are preferred; this covers the spots that
        // don't carry them (field types, ArrayRef adapters, extensions).
        inline std::string jx_cpp_type(const GenType &t) {
            if (t.kind == "vector") {
                return "std::vector<" +
                       (t.element.empty() ? std::string("double")
                                          : jx_cpp_type(t.element.front())) +
                       ">";
            }
            if (t.kind == "object" || t.kind == "enum") {
                return t.object_qualified.empty() ? t.object : t.object_qualified;
            }
            if (t.kind == "string") {
                return "std::string";
            }
            if (t.kind == "boolean") {
                return "bool";
            }
            if (t.kind == "number") {
                return t.spelling.empty() ? "double" : t.spelling;
            }
            return qualify_std(t.spelling);
        }

        // Vector parameters whose element is numeric can ALSO be taken as a
        // jlcxx::ArrayRef — a zero-copy view of a plain Julia Vector — so the
        // caller isn't forced to build a StdVector first. Julia's multiple
        // dispatch picks between this overload and the exact one.
        inline bool jx_numeric_vector(const GenType &t) {
            return t.kind == "vector" && !t.element.empty() &&
                   t.element.front().kind == "number";
        }
        inline bool jx_wants_arrayref_overload(const std::vector<GenParam> &params) {
            bool any = false;
            for (const auto &p : params) {
                if (p.type.kind == "vector") {
                    if (!jx_numeric_vector(p.type)) {
                        return false; // a non-numeric vector param has no ArrayRef form
                    }
                    any = true;
                }
            }
            return any;
        }

        // (lambda decls, forwarded args) for the ArrayRef overload: numeric
        // vector params become ArrayRef views (copied into a std::vector at
        // the call), everything else keeps its exact spelling when available.
        struct JxAdapterParams {
            std::string decls;
            std::string args;
        };
        inline JxAdapterParams jx_arrayref_params(const std::vector<GenParam>    &params,
                                                  const std::vector<std::string> &param_cpp) {
            JxAdapterParams a;
            for (std::size_t j = 0; j < params.size(); ++j) {
                const std::string an = "arg" + std::to_string(j);
                if (j) {
                    a.decls += ", ";
                    a.args += ", ";
                }
                const GenType &t = params[j].type;
                if (jx_numeric_vector(t)) {
                    const std::string el = jx_cpp_type(t.element.front());
                    a.decls += "jlcxx::ArrayRef<" + el + "> " + an;
                    a.args += "std::vector<" + el + ">(" + an + ".begin(), " + an + ".end())";
                } else if (j < param_cpp.size() && !param_cpp[j].empty()) {
                    a.decls += qualify_std(param_cpp[j]) + " " + an;
                    a.args += an;
                } else if (t.is_pointer) {
                    a.decls += t.object + " *" + an;
                    a.args += an;
                } else if (t.kind == "object") {
                    a.decls += "const " + jx_cpp_type(t) + " &" + an;
                    a.args += an;
                } else {
                    a.decls += jx_cpp_type(t) + " " + an;
                    a.args += an;
                }
            }
            return a;
        }

        // Exact-spelling (decls, args) for the wrapping lambdas (ref-return
        // copies, receiver-first calls).
        inline JxAdapterParams jx_exact_params(const std::vector<std::string> &param_cpp) {
            JxAdapterParams a;
            for (std::size_t j = 0; j < param_cpp.size(); ++j) {
                const std::string an = "arg" + std::to_string(j);
                if (j) {
                    a.decls += ", ";
                    a.args += ", ";
                }
                a.decls += qualify_std(param_cpp[j]) + " " + an;
                a.args += an;
            }
            return a;
        }

        // One enum: a jlcxx bits type + one module constant per enumerator.
        // Constants are PREFIXED with the enum name (`Kind_Point`) — Julia
        // module constants share one flat namespace with the registered types,
        // so a bare enumerator name collides with a same-named class (e.g.
        // `Kind::Point` vs `class Point` — "Duplicate registration") the
        // moment both are bound.
        inline std::string jx_enum(const GenEnum &e) {
            const std::string eq = qualified_of(e);
            const std::string ex = exposed_of(e);
            std::string       s  = "    mod.add_bits<" + eq + ">(\"" + ex +
                             "\", jlcxx::julia_type(\"CppEnum\"));\n";
            for (const auto &v : e.values) {
                s += "    mod.set_const(\"" + ex + "_" + v.name + "\", " + eq +
                     "::" + v.name + ");\n";
            }
            return s;
        }

        // One field: getter `name(obj)` + mutating setter `name!(obj, v)` —
        // Julia's `!` convention, matching the thin visitor. readonly (or a
        // non-copy-assignable type) drops the setter; a numeric `range` field
        // validates on assignment; a numeric-vector field gains an ArrayRef
        // setter overload so `tags!(m, [1.0, 2.0])` takes a plain Vector.
        inline std::string jx_field(const GenClass &k, const GenField &f) {
            const std::string self = qualified_of(k);
            const std::string ty   = jx_cpp_type(f.type);
            std::string       s;
            s += "    c.method(\"" + f.name + "\", [](const " + self + " &s) { return s." +
                 f.name + "; });\n";
            if (jx_field_readonly(f)) {
                return s;
            }
            if (setter_checked(f)) {
                s += "    c.method(\"" + f.name + "!\", [](" + self + " &s, " + setter_param(f, ty) +
                     ") {\n";
                s += setter_checks(f, "        ", [](const std::string &m) {
                    return "throw std::out_of_range(" + m + ")";
                });
                s += "        s." + f.name + " = v;\n";
                s += "    });\n";
                return s;
            }
            s += "    c.method(\"" + f.name + "!\", [](" + self + " &s, const " + ty +
                 " &v) { s." + f.name + " = v; });\n";
            if (jx_numeric_vector(f.type)) {
                const std::string el = jx_cpp_type(f.type.element.front());
                s += "    c.method(\"" + f.name + "!\", [](" + self + " &s, jlcxx::ArrayRef<" +
                     el + "> v) { s." + f.name + ".assign(v.begin(), v.end()); });\n";
            }
            return s;
        }

        // --- Held (reference-counted) classes: manifest "holders" -----------
        // jlcxx's own ownership model is the "allocated" box: an object Julia
        // owns, with a finalizer. A held class reuses it — every pointer that
        // crosses into Julia takes ONE reference and is boxed with a finalizer
        // that drops it (jx_holder_finalizers registers that finalizer, since
        // jlcxx only installs `delete` for destructible types). Pointers are
        // boxed as their most-derived bound class, so `GetOutputDataObject()`
        // hands Julia a vtkPolyData, not a vtkDataObject.

        // Index of k's policy among distinct_holders(c) — names its box helper.
        inline std::size_t jx_policy_index(const GenClass &k, const GenContext &c) {
            const auto hs = distinct_holders(c);
            for (std::size_t i = 0; i < hs.size(); ++i) {
                if (hs[i]->holder.holder == k.holder.holder) {
                    return i;
                }
            }
            return 0;
        }

        inline std::string jx_box_fn(const GenClass &held, const GenContext &c) {
            return "rosetta_jl_box_" + std::to_string(jx_policy_index(held, c));
        }

        // `rosetta_jl_box_N(P *r)`: nothing for a null pointer, else retain and
        // box as the deepest bound class r really is. One template per policy,
        // the candidate chain sorted deepest-first so a derived class is tried
        // before its bases; `if constexpr` drops the candidates unrelated to P.
        inline std::string jx_box_helpers(const GenContext &c) {
            std::string s;
            const auto  hs = distinct_holders(c);
            for (std::size_t i = 0; i < hs.size(); ++i) {
                std::vector<const GenClass *> held;
                for (const auto &k : c.classes) {
                    if (has_holder(k) && k.holder.holder == hs[i]->holder.holder) {
                        held.push_back(&k);
                    }
                }
                std::stable_sort(held.begin(), held.end(),
                                 [&](const GenClass *a, const GenClass *b) {
                                     return bound_depth(*a, c) > bound_depth(*b, c);
                                 });
                s += "\n// Retain a borrowed pointer and box it as its most-derived bound class.\n";
                s += "template <class P> jl_value_t *rosetta_jl_box_" + std::to_string(i) +
                     "(P *r) {\n";
                s += "    if (r == nullptr) {\n        return jl_nothing;\n    }\n";
                s += "    r->" + hs[i]->holder.retain + ";\n";
                s += "    if constexpr (std::is_polymorphic_v<P>) {\n";
                for (const GenClass *k : held) {
                    const std::string kq = qualified_of(*k);
                    s += "        if constexpr (std::is_base_of_v<P, " + kq + ">) {\n"
                         "            if (auto *d = dynamic_cast<" + kq + " *>(r)) {\n"
                         "                return jlcxx::boxed_cpp_pointer(d, jlcxx::julia_type<" + kq +
                         ">(), true).value;\n"
                         "            }\n"
                         "        }\n";
                }
                s += "    }\n";
                s += "    return jlcxx::boxed_cpp_pointer(r, jlcxx::julia_type<P>(), true).value;\n";
                s += "}\n";
            }
            return s;
        }

        // The finalizer of every held class's box: drop the one reference the
        // box stands for. Registered in CxxWrap's own module, where jlcxx would
        // have put its `delete`-based one for a destructible type.
        inline std::string jx_holder_finalizers(const GenContext &c) {
            std::string s;
            for (const auto &k : c.classes) {
                // A held class with a PUBLIC destructor (vtkCurvatures) gets
                // jlcxx's own __delete — see jx_holder_finalizer_specs, which
                // makes that one release instead of delete. Registering ours too
                // fails the module load ("Double registration for method").
                if (!has_holder(k) || k.is_destructible) {
                    continue;
                }
                s += "    mod.method(\"__delete\", [](" + qualified_of(k) + " *p) { p->" +
                     k.holder.release + "; });\n";
            }
            if (s.empty()) {
                return s;
            }
            return "    mod.set_override_module(jlcxx::get_cxxwrap_module());\n" + s +
                   "    mod.unset_override_module();\n";
        }

        // jlcxx registers a `delete`-based finalizer for every DESTRUCTIBLE
        // type it wraps. A reference-counted class may still have a public
        // destructor (vtkCurvatures), and deleting it from a Julia finalizer
        // would free an object VTK may still reference — so specialize jlcxx's
        // Finalizer for those to drop the box's one reference instead.
        inline std::string jx_holder_finalizer_specs(const GenContext &c) {
            std::string s;
            for (const auto &k : c.classes) {
                if (has_holder(k) && k.is_destructible) {
                    s += "    template <> struct Finalizer<" + qualified_of(k) +
                         ", SpecializedFinalizer> {\n"
                         "        static void finalize(" + qualified_of(k) + " *p) { p->" +
                         k.holder.release + "; }\n"
                         "    };\n";
                }
            }
            return s.empty() ? s : "\nnamespace jlcxx {\n" + s + "} // namespace jlcxx\n";
        }

        inline bool jx_has_held_pointer_param(const std::vector<GenParam> &params,
                                              const GenContext &c) {
            for (const auto &p : params) {
                if (held_pointee(p.type, c) != nullptr) {
                    return true;
                }
            }
            return false;
        }

        // A lambda for a method / function touching held pointers. `as_refs`:
        // every held-pointer parameter is taken by REFERENCE (a Julia box only
        // dispatches as `T` / `CxxRef{T}`, never as the `CxxPtr{T}` a `T*`
        // maps to) and its address is passed on; the pointer form stays bound
        // too, so `C_NULL` still reaches it. A held-pointer RESULT is boxed.
        inline std::string jx_held_lambda(const GenClass *k, const GenMethod &m,
                                          const std::string &callee, bool as_refs,
                                          const GenContext &c) {
            std::vector<std::string> decls, args;
            const bool receiver = k != nullptr && !m.is_static && !m.is_extension;
            if (receiver || m.is_extension) {
                decls.push_back(std::string(m.is_const ? "const " : "") + qualified_of(*k) +
                                " &self");
            }
            const bool exact = m.param_cpp.size() == m.params.size();
            for (std::size_t j = 0; j < m.params.size(); ++j) {
                const std::string an = "arg" + std::to_string(j);
                const GenClass   *hp = held_pointee(m.params[j].type, c);
                if (as_refs && hp != nullptr) {
                    decls.push_back(qualified_of(*hp) + " &" + an);
                    args.push_back("&" + an);
                } else {
                    decls.push_back((exact ? qualify_std(m.param_cpp[j])
                                           : jx_cpp_type(m.params[j].type)) +
                                    " " + an);
                    args.push_back(an);
                }
            }
            std::string call;
            if (m.is_extension) {
                call = m.ext_qualified + "(self" + (args.empty() ? "" : ", " + join(args, ", ")) + ")";
            } else if (receiver) {
                call = "self." + m.name + "(" + join(args, ", ") + ")";
            } else {
                call = callee + "(" + join(args, ", ") + ")";
            }
            const GenClass *ret = held_pointee(m.ret, c);
            if (ret != nullptr) {
                return "[](" + join(decls, ", ") + ") -> jl_value_t * { return " +
                       jx_box_fn(*ret, c) + "(" + call + "); }";
            }
            return "[](" + join(decls, ", ") + ") { return " + call + "; }";
        }

        // Registration lines for a method / function touching held pointers:
        // the boxed form, plus the by-reference overload when a parameter is a
        // held pointer.
        inline std::string jx_held_method(const GenClass *k, const GenMethod &m,
                                          const std::string &owner, const std::string &callee,
                                          const GenContext &c) {
            std::string s;
            if (held_pointee(m.ret, c) != nullptr) {
                s += "    " + owner + ".method(\"" + m.name + "\", " +
                     jx_held_lambda(k, m, callee, false, c) + ");\n";
            }
            if (jx_has_held_pointer_param(m.params, c)) {
                s += "    " + owner + ".method(\"" + m.name + "\", " +
                     jx_held_lambda(k, m, callee, true, c) + ");\n";
            }
            return s;
        }

        // `[](self, std::string a0, ...) { char *str0 = a0.data(); return
        // std::string(self.m(str0)); }` — a method or free function whose
        // signature names a C string or a path, re-typed to speak std::string
        // (jx_string_shape). Also boxes a held-pointer result, so the two
        // adapters compose.
        inline std::string jx_string_lambda(const GenClass *k, const GenMethod &m,
                                            const std::string &callee, const GenContext &c) {
            std::vector<std::string> decls, args;
            std::string              pre;
            const bool receiver = k != nullptr && !m.is_static && !m.is_extension;
            if (receiver || m.is_extension) {
                decls.push_back(std::string(m.is_const ? "const " : "") + qualified_of(*k) +
                                " &self");
            }
            const bool exact = m.param_cpp.size() == m.params.size();
            for (std::size_t j = 0; j < m.params.size(); ++j) {
                const std::string an = "arg" + std::to_string(j);
                const GenType    &t  = m.params[j].type;
                if (jx_string_shape(t)) {
                    const std::string sn = adapt_local(t, j);
                    decls.push_back("std::string " + an);
                    pre += adapt_decl_stmts(t, an, sn, "        ");
                    args.push_back(sn);
                } else {
                    decls.push_back((exact ? qualify_std(m.param_cpp[j]) : jx_cpp_type(t)) + " " +
                                    an);
                    args.push_back(an);
                }
            }
            std::string call;
            if (m.is_extension) {
                call = m.ext_qualified + "(self" + (args.empty() ? "" : ", " + join(args, ", ")) + ")";
            } else if (receiver) {
                call = "self." + m.name + "(" + join(args, ", ") + ")";
            } else {
                call = callee + "(" + join(args, ", ") + ")";
            }
            std::string body;
            if (jx_string_shape(m.ret)) {
                body = "        return " + adapt_from_expr(m.ret, call) + ";\n";
            } else if (const GenClass *h = held_pointee(m.ret, c)) {
                body = "        return " + jx_box_fn(*h, c) + "(" + call + ");\n";
            } else if (m.ret.kind == "void") {
                body = "        " + call + ";\n";
            } else {
                body = "        return " + call + ";\n";
            }
            return "[](" + join(decls, ", ") + ") {\n" + pre + body + "    }";
        }

        // One method. jlcxx makes the object the first Julia argument
        // (`name(obj, ...)`); a static becomes a module-level function. The
        // member pointer is disambiguated with an explicit cast to the exact
        // signature — dropping any `noexcept` (jlcxx's method() templates
        // don't match noexcept pointers; the conversion is implicit). An
        // lvalue-ref class/vector return is wrapped in a lambda that returns
        // by VALUE — the same copy pybind's `automatic` policy makes — so the
        // Julia side always holds a plain object. An extension method binds
        // its free function directly (receiver-first, exactly jlcxx's shape).
        inline std::string jx_method(const GenClass &k, const GenMethod &m, const GenContext &c) {
            // An extension is a free function: jlcxx's TypeWrapper::method takes
            // only member pointers and lambdas, so it is registered on the
            // module, where Julia's dispatch on its first (receiver) argument
            // makes it a method of the class all the same.
            const std::string owner = (m.is_static || m.is_extension) ? "mod" : "c";
            const bool        copy_ret =
                m.ret_is_ref && (m.ret.kind == "object" || m.ret.kind == "vector");
            std::string primary;
            if (m.is_extension) {
                primary = "&" + m.ext_qualified;
            } else if (copy_ret) {
                const JxAdapterParams xp = jx_exact_params(m.param_cpp);
                std::string           decls, call;
                if (m.is_static) {
                    decls = xp.decls;
                    call  = qualified_of(k) + "::" + m.name + "(" + xp.args + ")";
                } else {
                    decls = (m.is_const ? "const " : "") + qualified_of(k) + " &self" +
                            (xp.decls.empty() ? "" : ", " + xp.decls);
                    call = "self." + m.name + "(" + xp.args + ")";
                }
                primary = "[](" + decls + ") -> " + jx_cpp_type(m.ret) + " { return " + call +
                          "; }";
            } else {
                std::string args;
                for (std::size_t j = 0; j < m.param_cpp.size(); ++j) {
                    args += (j ? ", " : "") + qualify_std(m.param_cpp[j]);
                }
                const std::string quals = m.is_const ? " const" : ""; // noexcept dropped
                const std::string ret   = qualify_std(m.ret_cpp);
                const std::string fp =
                    m.is_static ? (ret + " (*)(" + args + ")")
                                : (ret + " (" + qualified_of(k) + "::*)(" + args + ")" + quals);
                primary = "static_cast<" + fp + ">(&" + qualified_of(k) + "::" + m.name + ")";
            }
            std::string s;
            if (jx_touches_string(m)) {
                return "    " + owner + ".method(\"" + m.name + "\", " +
                       jx_string_lambda(&k, m, qualified_of(k) + "::" + m.name, c) + ");\n";
            }
            // A held-pointer result is boxed (jx_held_method) instead of being
            // handed out as a non-owning CxxPtr; a held-pointer parameter gains
            // a by-reference overload next to the pointer form.
            if (held_pointee(m.ret, c) == nullptr) {
                s += "    " + owner + ".method(\"" + m.name + "\", " + primary + ");\n";
            }
            s += jx_held_method(&k, m, owner, qualified_of(k) + "::" + m.name, c);
            // Numeric-vector parameters: add the plain-Julia-Vector overload.
            if (jx_wants_arrayref_overload(m.params)) {
                const JxAdapterParams ap = jx_arrayref_params(m.params, m.param_cpp);
                std::string           decls, call;
                if (m.is_extension) {
                    // A free function wearing a method's name — the overload
                    // a plain Julia Vector needs as much as a member does.
                    decls = qualified_of(k) + " &self" + (ap.decls.empty() ? "" : ", " + ap.decls);
                    call  = m.ext_qualified + "(self" + (ap.args.empty() ? "" : ", " + ap.args) + ")";
                } else if (m.is_static) {
                    decls = ap.decls;
                    call  = qualified_of(k) + "::" + m.name + "(" + ap.args + ")";
                } else {
                    decls = (m.is_const ? "const " : "") + qualified_of(k) + " &self" +
                            (ap.decls.empty() ? "" : ", " + ap.decls);
                    call = "self." + m.name + "(" + ap.args + ")";
                }
                s += "    " + owner + ".method(\"" + m.name + "\", [](" + decls +
                     ") { return " + call + "; });\n";
            }
            return s;
        }

        // The constructors: `.constructor<exact spellings...>()` for each
        // marshalable one (jlcxx dispatches overloads through Julia's multiple
        // dispatch), a factory-lambda variant taking ArrayRef views when a
        // ctor names numeric vectors, and a synthetic default when the type is
        // default-constructible (jlcxx guards against double registration).
        // An abstract class gets none.
        inline std::string jx_ctors(const GenClass &k, const GenContext &c) {
            std::string s;
            bool        saw_default = false;
            // A held class: its library's factory is the constructor, and the
            // box adopts the reference the factory returns (finalized by
            // jx_holder_finalizers). Its own constructors are not public.
            if (has_holder(k)) {
                if (k.holder.creatable) {
                    s += "    c.constructor([]() { return " + qualified_of(k) + "::" +
                         k.holder.factory + "(); });\n";
                }
                return s;
            }
            for (std::size_t i = 0; !k.is_abstract && i < k.ctor_param_cpp.size(); ++i) {
                bool ok = true;
                for (const auto &p : k.ctors[i]) {
                    ok = ok && jx_marshalable(p.type, c) &&
                         (p.type.kind != "object" || p.is_ref || p.type.copy_constructible) &&
                         (p.type.kind != "vector" || jx_copyable(p.type)) &&
                         (p.type.kind == "object" || !p.is_mutable_ref);
                }
                if (!ok) {
                    continue;
                }
                const auto &params = k.ctor_param_cpp[i];
                if (params.empty()) {
                    saw_default = true;
                }
                std::string args;
                for (std::size_t j = 0; j < params.size(); ++j) {
                    args += (j ? ", " : "") + qualify_std(params[j]);
                }
                s += "    c.constructor<" + args + ">();\n";
                if (jx_wants_arrayref_overload(k.ctors[i])) {
                    const JxAdapterParams ap = jx_arrayref_params(k.ctors[i], params);
                    s += "    c.constructor([](" + ap.decls + ") { return new " + qualified_of(k) + "(" +
                         ap.args + "); });\n";
                }
            }
            if (!saw_default && !k.is_abstract && k.is_default_constructible) {
                s += "    c.constructor<>();\n";
            }
            return s;
        }

        // First bound base of a class, or "" — jlcxx (like embind) registers
        // single inheritance only.
        inline std::string jx_bound_base(const GenClass &k, const GenContext &c) {
            for (const auto &b : k.bases) {
                for (const auto &g : c.classes) {
                    if (qualified_of(g) == b) {
                        return b;
                    }
                }
            }
            return std::string{};
        }

        // Registration is TWO-PHASE (the canonical jlcxx pattern for
        // interdependent types): first add_type for every class, then populate
        // constructors/fields/methods. jlcxx resolves each method's argument
        // and return types at registration time, so a one-pass emission would
        // fail with "No appropriate factory for type X" whenever a method of
        // an earlier class names a later one (Model::addSurface(Surface&)).
        inline std::string jx_class_decl(const GenClass &k, const GenContext &c) {
            const std::string base = jx_bound_base(k, c);
            std::string       s;
            s += "    auto c_" + exposed_of(k) + " = mod.add_type<" + qualified_of(k) + ">(\"" +
                 exposed_of(k) + "\"";
            if (!base.empty()) {
                // Bound single base (jlcxx, like embind, registers one). The
                // base's add_type must precede this — i.e. list the base first
                // in the manifest.
                s += ", jlcxx::julia_base_type<" + base + ">()";
            }
            s += ");\n";
            return s;
        }

        // A static method is registered on the MODULE, so two bound classes
        // declaring the same static (VTK: SafeDownCast / IsTypeOf in every
        // class) would define one Julia method twice — the later silently
        // replacing the earlier. True when a class listed before `k` already
        // owns a static with this name and exact parameter list.
        inline bool jx_static_taken(const GenClass &k, const GenMethod &m, const GenContext &c) {
            for (const auto &other : c.classes) {
                if (&other == &k) {
                    return false;
                }
                for (const auto &om : other.methods) {
                    if (om.is_static && om.name == m.name && om.param_cpp == m.param_cpp &&
                        jx_method_ok(om, c) && !owned_pointer_return(om.name, om.ret, c)) {
                        return true;
                    }
                }
            }
            return false;
        }

        inline std::string jx_class_members(const GenClass &k, const GenContext &c) {
            std::string s = "    {\n";
            s += "    auto &c = c_" + exposed_of(k) + ";\n";
            s += jx_ctors(k, c);
            for (const auto &f : k.fields) {
                if (!jx_field_ok(f, c)) {
                    continue; // type jlcxx can't marshal — see jx_field_ok
                }
                s += jx_field(k, f);
            }
            // Every overload binds: jlcxx registers each one as a Julia method
            // of the same name, and Julia's multiple dispatch picks by argument
            // type at call time — the one target language where an overload set
            // maps onto the host's own idiom exactly. jx_method spells an
            // explicit cast, so the C++ member pointer is unambiguous.
            for (const auto &m : k.methods) {
                if (owned_pointer_return(m.name, m.ret, c)) {
                    coverage::note_skip("julia", k, m, "owned_pointer_return",
                                        "returns a new reference (a factory, per the holder "
                                        "policy's owned_returns); the constructor creates "
                                        "objects instead");
                    continue;
                }
                if (!jx_method_ok(m, c)) {
                    coverage::note_skip("julia", k, m, "unmarshalable_signature",
                                        "jlcxx has no conversion for a type in this signature");
                    continue; // signature the emitted jlcxx line could not compile
                }
                if (m.is_static && jx_static_taken(k, m, c)) {
                    coverage::note_skip("julia", k, m, "static_name_collision",
                                        "a static method becomes a module-level Julia function, "
                                        "and an earlier class already defines one with this "
                                        "name and signature");
                    continue;
                }
                s += jx_method(k, m, c);
                coverage::note_bound("julia", k, m);
            }
            s += "    }\n";
            return s;
        }

        // The `<lib>.jl` loader: a Julia module wrapping the shared library
        // through CxxWrap. `include("<lib>.jl"); using .<lib>` is all a script
        // needs (the post-build copy puts the library beside it).
        inline std::string jx_loader(const GenContext &c) {
            std::string s;
            s += "# Generated by rosetta::generate — do not edit by hand.\n";
            s += "module " + c.lib + "\n";
            s += "using CxxWrap\n";
            s += "@wrapmodule(() -> joinpath(@__DIR__, \"lib" + c.lib + "\"))\n";
            s += "function __init__()\n";
            s += "    @initcxx\n";
            s += "end\n";
            s += "end # module\n";
            return s;
        }

        inline std::vector<std::pair<std::string, std::string>>
        julia_sources(const GenContext &c); // defined below

        inline std::string julia_expanded_source(const GenContext &c) {
            return julia_sources(c).front().second;
        }

        // The julia binding as (file name, contents) pairs: auto_jlcxx.cpp,
        // then one auto_jlcxx_part_K.cpp per extra class slice. Phase 1 (every
        // add_type) and the finalizers stay in the module entry, which then
        // calls `rosetta_jl_part_K(mod)` for the phase-2 member blocks. A part
        // has no `c_X` wrapper of its own, so it rebuilds one from what
        // add_type registered: the concrete "Allocated" box type is
        // julia_type<T>(), its supertype the abstract type.
        inline std::vector<std::pair<std::string, std::string>>
        julia_sources(const GenContext &c) {
            const auto               slices = class_slices(c);
            const bool               split  = slices.size() > 1;
            std::vector<std::string> parts;
            std::string body;
            for (const auto &e : c.enums) {
                body += jx_enum(e);
            }
            // Phase 1: register every class; phase 2: populate members (see
            // jx_class_decl for why the split is required).
            for (const auto &k : c.classes) {
                body += jx_class_decl(k, c);
            }
            body += jx_holder_finalizers(c);
            for (const auto &[lo, hi] : slices) {
                if (!split) {
                    for (std::size_t i = lo; i < hi; ++i) {
                        body += jx_class_members(c.classes[i], c);
                    }
                    continue;
                }
                std::string part;
                for (std::size_t i = lo; i < hi; ++i) {
                    const GenClass   &k = c.classes[i];
                    const std::string q = qualified_of(k);
                    part += "    jlcxx::TypeWrapper<" + q + "> c_" + exposed_of(k) +
                            "(mod, jlcxx::julia_type<" + q + ">()->super, jlcxx::julia_type<" + q +
                            ">());\n";
                    part += jx_class_members(k, c);
                }
                body += "    rosetta_jl_part_" + std::to_string(parts.size()) + "(mod);\n";
                parts.push_back(std::move(part));
            }
            for (const auto &f : c.functions) {
                GenMethod probe; // free functions go through the same gates
                probe.ret        = f.ret;
                probe.params     = f.params;
                probe.ret_is_ref = false; // GenFunction doesn't carry it; by-value assumed
                if (!jx_method_ok(probe, c)) {
                    coverage::note_skip_function("julia", f, "unmarshalable_signature",
                                                 "no jlcxx conversion for a type in this "
                                                 "signature");
                    continue;
                }
                if (owned_pointer_return(f.name, f.ret, c)) {
                    coverage::note_skip_function("julia", f, "owned_pointer_return",
                                                 "returns a new reference (a factory, per the "
                                                 "holder policy's owned_returns)");
                    continue;
                }
                coverage::note_bound_function("julia", f);
                probe.name      = f.name;
                probe.is_static = true;
                if (jx_touches_string(probe)) {
                    body += "    mod.method(\"" + f.name + "\", " +
                            jx_string_lambda(nullptr, probe, fn_call_expr(f), c) + ");\n";
                    continue;
                }
                if (held_pointee(f.ret, c) == nullptr) {
                    body += "    mod.method(\"" + f.name + "\", " + fn_addr(f) + ");\n";
                }
                body += jx_held_method(nullptr, probe, "mod", fn_call_expr(f), c);
                if (jx_wants_arrayref_overload(f.params)) {
                    const JxAdapterParams ap = jx_arrayref_params(f.params, {});
                    body += "    mod.method(\"" + f.name + "\", [](" + ap.decls +
                            ") { return " + fn_call_expr(f) + "(" + ap.args + "); });\n";
                }
            }

            std::string out = "// Generated by rosetta::generate (expanded, reflection-free) — "
                              "do not edit by hand.\n";
            // User headers FIRST (types must be complete for the SuperType
            // specializations below), then jlcxx. stl.hpp registers any
            // std::vector<T> lazily on first use — including vectors of bound
            // classes — which the thin backend cannot compile (fork libc++).
            auto add = [&](const std::string &h) { append_include(out, h); };
            out += init_includes(c);
            for (const auto &k : c.classes) {
                add(k.header);
                for (const auto &m : k.methods) {
                    if (m.is_extension && !m.ext_header.empty()) {
                        add(m.ext_header); // the free function behind an extension method
                    }
                }
            }
            for (const auto &e : c.enums) {
                add(e.header);
            }
            for (const auto &f : c.functions) {
                add(f.header);
            }
            out += "#include <jlcxx/jlcxx.hpp>\n"
                   "#include <jlcxx/stl.hpp>\n"
                   "#include <stdexcept>\n"
                   "#include <type_traits>\n"
                   "#include <string>\n"
                   "#include <vector>\n";
            out += regex_include(c);
            out += using_namespaces_of(c); // `using namespace` for namespaced user types
            // C++ inheritance: jlcxx requires a SuperType specialization for
            // every type registered with julia_base_type (single base).
            std::string supers;
            for (const auto &k : c.classes) {
                const std::string base = jx_bound_base(k, c);
                if (!base.empty()) {
                    supers += "    template <> struct SuperType<" + qualified_of(k) + "> { typedef " +
                              base + " type; };\n";
                }
            }
            if (!supers.empty()) {
                out += "\nnamespace jlcxx {\n" + supers + "} // namespace jlcxx\n";
            }
            out += jx_holder_finalizer_specs(c); // release, not delete, for held classes
            out += jx_box_helpers(c); // boxing for held (reference-counted) classes
            const std::string pre = out;
            for (std::size_t k = 0; k < parts.size(); ++k) {
                out += (k ? "" : "\n") + std::string("void rosetta_jl_part_") +
                       std::to_string(k) + "(jlcxx::Module &mod);\n";
            }
            out += "\n// CxxWrap.jl loads this entry point (default symbol "
                   "`define_julia_module`)\n// from Julia via `@wrapmodule(() -> libpath)`.\n";
            out += "JLCXX_MODULE define_julia_module(jlcxx::Module &mod) {\n";
            out += init_block(c);
            out += body;
            out += "}\n";
            std::vector<std::pair<std::string, std::string>> files{{"auto_jlcxx.cpp", out}};
            for (std::size_t k = 0; k < parts.size(); ++k) {
                const std::string id = std::to_string(k);
                files.emplace_back("auto_jlcxx_part_" + id + ".cpp",
                                   pre + "\n// Part " + id + " of the member registrations.\n"
                                         "void rosetta_jl_part_" + id +
                                         "(jlcxx::Module &mod) {\n" + parts[k] + "}\n");
            }
            return files;
        }

        inline std::string Julia::render(const GenContext &c) const {
            return julia_expanded_source(c);
        }

        inline void Julia::emit(const GenContext &c) const {
            auto dir = c.out_dir / "julia";
            const auto  files = julia_sources(c);
            std::string list;
            for (const auto &[name, text] : files) {
                write_file(dir / name, text);
                list += (list.empty() ? "" : " ") + name;
            }
            remove_stale_parts(dir, "auto_jlcxx_part_", files.size() - 1);
            write_file(dir / "CMakeLists.txt",
                       replace_once(render_meta(JULIAX_CMAKE, c),
                                    "add_library(" + c.lib + " SHARED auto_jlcxx.cpp)",
                                    "add_library(" + c.lib + " SHARED " + list + ")"));
            write_file(dir / (c.lib + ".jl"), jx_loader(c));
            write_file(dir / "README.md",
                       readme("julia", c,
                              subst(JULIAX_README_BUILD, {{"LIB", c.lib}})));
        }

