        // — which is precisely why <jlcxx/stl.hpp> (std::vector support)
        // compiles here while the thin julia backend must skip vectors.
        constexpr std::string_view JULIAX_CMAKE =
            R"CMK(# Generated by rosetta::generate (expanded, reflection-free) — do not edit by hand.
# These bindings are plain jlcxx: NO C++26, NO reflection, NO rosetta headers.
