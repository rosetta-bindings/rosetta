{
  "name":     { "doc": "Display name of the mesh", "label": "Name",
                "widget": "textfield" },
  "visible":  { "doc": "Draw this mesh", "label": "Visible", "widget": "checkbox" },
  "colour":   { "doc": "Base colour as #rrggbb", "label": "Colour", "widget": "color" },
  "opacity":  { "doc": "Blend factor, 0 = invisible", "range": [0, 1],
                "label": "Opacity", "widget": "slider" },
  "size":     { "doc": "Uniform scale factor", "range": [0.1, 5],
                "label": "Size", "widget": "slider" },
  "spin":     { "doc": "Rotation about the Y axis, in degrees", "range": [0, 360],
                "label": "Spin", "widget": "slider" },
  "shading":  { "doc": "Shading model", "label": "Shading" },
  "preset":   { "doc": "Named material preset",
                "combobox": ["default", "matte", "glossy", "glass"],
                "label": "Preset", "widget": "radio" },
  "id":       { "doc": "Server-assigned identifier", "readonly": true, "label": "ID" },
  "origin":   { "doc": "Local origin in world space", "label": "Origin" },
  "weights":  { "doc": "Per-vertex blend weights", "label": "Weights" },

  "positions":     { "doc": "Vertex positions, flat xyz in object space" },
  "triangles":     { "doc": "Triangle indices, three per face" },
  "vertexCount":   { "doc": "Number of vertices" },
  "triangleCount": { "doc": "Number of triangles" },
  "at":            { "doc": "Weight at an index, or the product of two" },
  "originRef":     { "doc": "The origin, by reference — edits hit this mesh" },
  "translate":     { "doc": "Move the origin by a delta" },
  "describe":      { "doc": "One-line summary", "button": "Describe" },
  "reset":         { "doc": "Restore the default transform", "button": "Reset" },
  "subdivide":     { "doc": "Split every triangle into four", "button": "Subdivide" },
  "cube":          { "doc": "Build a unit cube" },
  "plane":         { "doc": "Build a unit plane in XZ" },
  "sphere":        { "doc": "Build a UV sphere with rings x segments" },
  "bunny":         { "doc": "The Stanford bunny, recentred into a unit box" },
  "onProgress":    { "doc": "Register a progress callback" },
  "setPositions":  { "doc": "Replace the vertex positions; ignored unless the count matches" }
}
